{
  "name": "nodejs-18-typescript",
  "version": "1.0.0",
  "main": "app.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "npm run build && cp .env build/ && npm run migration && node build/app.js",
    "migration": "npx sequelize-cli db:migrate --env=production",
    "undo:migration": "npx sequelize-cli db:migrate:undo --env=production",
    "create:migration": "npx sequelize-cli migration:generate --name auto-generated-migration --env=production",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.7.9",
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "sequelize": "^6.37.5",
    "tsc-alias": "^1.8.10"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
